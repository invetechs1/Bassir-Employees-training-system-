# ---------------------------------------------------------------------------
# BCAP environment configuration
# Copy to `.env` and fill in real values. Never commit `.env`.
# ---------------------------------------------------------------------------

# PostgreSQL connection string.
# The application connects as a NON-superuser role so that Row-Level Security
# (RLS) tenant isolation is actually enforced. Superusers bypass RLS.
DATABASE_URL="postgresql://bcap_app:bcap_app_password@localhost:5432/bcap?schema=public"

# Secret used to sign session JWTs (HS256). Generate with:
#   openssl rand -base64 48
AUTH_SECRET="change-me-to-a-long-random-string"

# Public base URL of the app (used for building tenant subdomain links, emails, etc.)
APP_BASE_URL="http://localhost:3000"

# Root domain used for tenant subdomains, e.g. "bcap.app" -> "acme.bcap.app".
# Leave as localhost for local development (path-based tenant routing is used instead).
ROOT_DOMAIN="localhost:3000"

# Session lifetime in seconds (default 8 hours).
SESSION_TTL_SECONDS="28800"

# ---------------------------------------------------------------------------
# Email (optional) — used to send employee invitation links.
# If these are not set, invitations still work: the admin is shown a link to
# share manually. Configure any SMTP provider (e.g. SendGrid, SES, Postmark).
# ---------------------------------------------------------------------------
# SMTP_HOST="smtp.example.com"
# SMTP_PORT="587"
# SMTP_SECURE="false"          # "true" for port 465
# SMTP_USER="apikey-or-username"
# SMTP_PASS="your-smtp-password"
# SMTP_FROM="BCAP <no-reply@yourcompany.com>"

# ---------------------------------------------------------------------------
# Stripe (optional) — enables real subscription checkout & billing portal.
# Without these, plan changes apply in-app (no payment). Create recurring
# Prices in Stripe for the Growth and Enterprise plans and paste their IDs.
# ---------------------------------------------------------------------------
# STRIPE_SECRET_KEY="sk_live_or_test_..."
# STRIPE_WEBHOOK_SECRET="whsec_..."           # from `stripe listen` / dashboard
# STRIPE_PRICE_GROWTH="price_..."
# STRIPE_PRICE_ENTERPRISE="price_..."
