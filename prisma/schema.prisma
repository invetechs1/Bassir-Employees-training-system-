// ===========================================================================
// BASSIR CORPORATE ACADEMY PLATFORM (BCAP)
// Multi-tenant enterprise workforce transformation SaaS.
//
// Tenancy model: SHARED DATABASE, TENANT_ID COLUMN, enforced by PostgreSQL
// Row-Level Security (RLS). Every tenant-scoped table carries `tenantId` and
// is protected by an RLS policy keyed on the `app.current_tenant` session
// variable. See prisma/migrations/**/rls.sql and src/lib/tenant-db.ts.
// ===========================================================================

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ---------------------------------------------------------------------------
// PLATFORM / TENANCY
// ---------------------------------------------------------------------------

enum TenantStatus {
  ACTIVE
  SUSPENDED
  TRIAL
  CANCELLED
}

enum Industry {
  ENGINEERING_CONSULTANCY
  CONSTRUCTION_CONTRACTING
  LOGISTICS
  MANUFACTURING
  FINANCE
  HEALTHCARE
  TECHNOLOGY
  RETAIL
  OTHER
}

enum PlanTier {
  STARTER
  GROWTH
  ENTERPRISE
}

/// A company/customer. The root of every tenant-scoped record.
model Tenant {
  id        String       @id @default(cuid())
  name      String
  slug      String       @unique // used for path/subdomain routing, e.g. "alarrab"
  subdomain String?      @unique
  industry  Industry     @default(OTHER)
  status    TenantStatus @default(TRIAL)
  plan      PlanTier     @default(GROWTH)
  country   String       @default("SA")
  timezone  String       @default("Asia/Riyadh")
  locale    String       @default("en")
  createdAt DateTime     @default(now())
  updatedAt DateTime     @updatedAt

  branches           Branch[]
  departments        Department[]
  users              User[]
  roles              Role[]
  competencyCategories CompetencyCategory[]
  competencies       Competency[]
  competencyRatings  CompetencyRating[]
  trainingPrograms   TrainingProgram[]
  enrollments        Enrollment[]
  certifications     Certification[]
  certificationAwards CertificationAward[]
  criticalRoles      CriticalRole[]
  successionCandidates SuccessionCandidate[]
  auditLogs          AuditLog[]

  @@map("tenants")
}

// ---------------------------------------------------------------------------
// ORG STRUCTURE
// ---------------------------------------------------------------------------

model Branch {
  id        String   @id @default(cuid())
  tenantId  String
  name      String
  city      String?
  country   String   @default("SA")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  tenant      Tenant       @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  departments Department[]
  users       User[]

  @@index([tenantId])
  @@map("branches")
}

model Department {
  id        String   @id @default(cuid())
  tenantId  String
  branchId  String?
  name      String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  tenant Tenant  @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  branch Branch? @relation(fields: [branchId], references: [id], onDelete: SetNull)
  users  User[]

  @@index([tenantId])
  @@map("departments")
}

// ---------------------------------------------------------------------------
// IDENTITY & ACCESS
// ---------------------------------------------------------------------------

enum UserStatus {
  ACTIVE
  INVITED
  DISABLED
}

model User {
  id           String     @id @default(cuid())
  tenantId     String
  email        String
  passwordHash String
  firstName    String
  lastName     String
  jobTitle     String?
  status       UserStatus @default(ACTIVE)
  isTenantOwner Boolean   @default(false)
  // Force a password change on next login (set for admin-invited employees).
  mustChangePassword Boolean @default(false)

  branchId     String?
  departmentId String?
  managerId    String?

  // 9-box talent grid placement (1..3 each). Null until assessed.
  performanceRating Int?
  potentialRating   Int?

  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt
  lastLoginAt  DateTime?

  tenant     Tenant       @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  branch     Branch?      @relation(fields: [branchId], references: [id], onDelete: SetNull)
  department Department?  @relation(fields: [departmentId], references: [id], onDelete: SetNull)
  manager    User?        @relation("UserManager", fields: [managerId], references: [id], onDelete: SetNull)
  reports    User[]       @relation("UserManager")

  userRoles       UserRole[]
  enrollments     Enrollment[]
  authoredPrograms TrainingProgram[] @relation("ProgramAuthor")
  competencyRatings CompetencyRating[]
  certificationAwards CertificationAward[]
  incumbentOf     CriticalRole[]      @relation("RoleIncumbent")
  successionCandidacies SuccessionCandidate[]
  auditLogs       AuditLog[]

  // Email is unique WITHIN a tenant, not globally — the same person may exist
  // in multiple companies.
  @@unique([tenantId, email])
  @@index([tenantId])
  @@index([managerId])
  @@map("users")
}

/// Roles are tenant-scoped. System-default roles are cloned into each tenant
/// at provisioning time (see prisma/seed.ts).
model Role {
  id          String   @id @default(cuid())
  tenantId    String
  key         String // stable identifier, e.g. "admin", "manager", "learner"
  name        String
  description String?
  isSystem    Boolean  @default(false)
  createdAt   DateTime @default(now())

  tenant          Tenant           @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  userRoles       UserRole[]
  rolePermissions RolePermission[]

  @@unique([tenantId, key])
  @@index([tenantId])
  @@map("roles")
}

/// Global permission catalog (NOT tenant-scoped). Keys are referenced in code.
model Permission {
  id          String   @id @default(cuid())
  key         String   @unique // e.g. "training.program.create"
  description String
  category    String   @default("general")

  rolePermissions RolePermission[]

  @@map("permissions")
}

model RolePermission {
  roleId       String
  permissionId String

  role       Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@id([roleId, permissionId])
  @@map("role_permissions")
}

model UserRole {
  userId String
  roleId String

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  role Role @relation(fields: [roleId], references: [id], onDelete: Cascade)

  @@id([userId, roleId])
  @@map("user_roles")
}

// ---------------------------------------------------------------------------
// COMPETENCY FRAMEWORK  (core differentiator vs. an LMS)
// ---------------------------------------------------------------------------

model CompetencyCategory {
  id        String   @id @default(cuid())
  tenantId  String
  name      String
  createdAt DateTime @default(now())

  tenant       Tenant       @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  competencies Competency[]

  @@index([tenantId])
  @@map("competency_categories")
}

model Competency {
  id          String   @id @default(cuid())
  tenantId    String
  categoryId  String?
  name        String
  description String?
  createdAt   DateTime @default(now())

  tenant   Tenant              @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  category CompetencyCategory? @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  programs TrainingProgram[]
  ratings  CompetencyRating[]
  certifications Certification[]

  @@index([tenantId])
  @@map("competencies")
}

// ---------------------------------------------------------------------------
// COMPETENCY ASSESSMENTS  (measure real capability, not just completions)
// ---------------------------------------------------------------------------

/// One employee's assessed level on one competency. Levels are 1..5.
/// `current` is the working level; self/manager are the assessment inputs.
model CompetencyRating {
  id           String   @id @default(cuid())
  tenantId     String
  userId       String
  competencyId String
  selfLevel    Int      @default(1)
  managerLevel Int      @default(1)
  currentLevel Int      @default(1)
  targetLevel  Int      @default(3)
  updatedAt    DateTime @updatedAt

  tenant     Tenant     @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  user       User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  competency Competency @relation(fields: [competencyId], references: [id], onDelete: Cascade)

  @@unique([userId, competencyId])
  @@index([tenantId])
  @@map("competency_ratings")
}

// ---------------------------------------------------------------------------
// CORPORATE UNIVERSITY — INTERNAL CERTIFICATIONS
// ---------------------------------------------------------------------------

enum CertificationStatus {
  ACTIVE
  EXPIRING
  EXPIRED
}

model Certification {
  id              String              @id @default(cuid())
  tenantId        String
  name            String
  competencyId    String?
  validityMonths  Int                 @default(24)
  status          CertificationStatus @default(ACTIVE)
  createdAt       DateTime            @default(now())

  tenant     Tenant               @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  competency Competency?          @relation(fields: [competencyId], references: [id], onDelete: SetNull)
  awards     CertificationAward[]

  @@index([tenantId])
  @@map("certifications")
}

model CertificationAward {
  id              String    @id @default(cuid())
  tenantId        String
  certificationId String
  userId          String
  issuedAt        DateTime  @default(now())
  expiresAt       DateTime?

  tenant        Tenant        @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  certification Certification @relation(fields: [certificationId], references: [id], onDelete: Cascade)
  user          User          @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([certificationId, userId])
  @@index([tenantId])
  @@map("certification_awards")
}

// ---------------------------------------------------------------------------
// LEADERSHIP & SUCCESSION
// ---------------------------------------------------------------------------

enum SuccessionReadiness {
  READY_NOW
  ONE_TO_TWO_YEARS
  THREE_PLUS_YEARS
}

model CriticalRole {
  id          String   @id @default(cuid())
  tenantId    String
  title       String
  incumbentId String?
  createdAt   DateTime @default(now())

  tenant     Tenant                @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  incumbent  User?                 @relation("RoleIncumbent", fields: [incumbentId], references: [id], onDelete: SetNull)
  candidates SuccessionCandidate[]

  @@index([tenantId])
  @@map("critical_roles")
}

model SuccessionCandidate {
  id             String              @id @default(cuid())
  tenantId       String
  criticalRoleId String
  userId         String
  readiness      SuccessionReadiness @default(ONE_TO_TWO_YEARS)
  score          Int                 @default(50) // readiness %, 0..100

  tenant       Tenant       @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  criticalRole CriticalRole @relation(fields: [criticalRoleId], references: [id], onDelete: Cascade)
  user         User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([criticalRoleId, userId])
  @@index([tenantId])
  @@map("succession_candidates")
}

// ---------------------------------------------------------------------------
// TRAINING / DEVELOPMENT  (the end-to-end working module for Phase 1)
// ---------------------------------------------------------------------------

enum ProgramLevel {
  FOUNDATION
  INTERMEDIATE
  ADVANCED
  LEADERSHIP
}

enum ProgramStatus {
  DRAFT
  PUBLISHED
  ARCHIVED
}

model TrainingProgram {
  id           String        @id @default(cuid())
  tenantId     String
  title        String
  description  String?
  level        ProgramLevel  @default(FOUNDATION)
  status       ProgramStatus @default(DRAFT)
  durationHours Int          @default(0)
  competencyId String?
  authorId     String?
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt

  tenant     Tenant       @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  competency Competency?  @relation(fields: [competencyId], references: [id], onDelete: SetNull)
  author     User?        @relation("ProgramAuthor", fields: [authorId], references: [id], onDelete: SetNull)
  enrollments Enrollment[]

  @@index([tenantId])
  @@map("training_programs")
}

enum EnrollmentStatus {
  ENROLLED
  IN_PROGRESS
  COMPLETED
  DROPPED
}

model Enrollment {
  id          String           @id @default(cuid())
  tenantId    String
  programId   String
  userId      String
  status      EnrollmentStatus @default(ENROLLED)
  progress    Int              @default(0) // 0-100
  score       Int? // final assessment score, 0-100
  enrolledAt  DateTime         @default(now())
  completedAt DateTime?

  tenant  Tenant          @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  program TrainingProgram @relation(fields: [programId], references: [id], onDelete: Cascade)
  user    User            @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([programId, userId])
  @@index([tenantId])
  @@index([userId])
  @@map("enrollments")
}

// ---------------------------------------------------------------------------
// AUDIT
// ---------------------------------------------------------------------------

model AuditLog {
  id        String   @id @default(cuid())
  tenantId  String
  actorId   String?
  action    String // e.g. "user.login", "training.program.create"
  entity    String? // e.g. "TrainingProgram"
  entityId  String?
  metadata  Json?
  createdAt DateTime @default(now())

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  actor  User?  @relation(fields: [actorId], references: [id], onDelete: SetNull)

  @@index([tenantId])
  @@index([tenantId, createdAt])
  @@map("audit_logs")
}
