// ===========================================================================
// BASSIR CORPORATE ACADEMY PLATFORM (BCAP)
// Multi-tenant enterprise workforce transformation SaaS.
//
// Tenancy model: SHARED DATABASE, TENANT_ID COLUMN, enforced by PostgreSQL
// Row-Level Security (RLS). Every tenant-scoped table carries `tenantId` and
// is protected by an RLS policy keyed on the `app.current_tenant` session
// variable. See prisma/migrations/**/rls.sql and src/lib/tenant-db.ts.
// ===========================================================================

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ---------------------------------------------------------------------------
// PLATFORM / TENANCY
// ---------------------------------------------------------------------------

enum TenantStatus {
  ACTIVE
  SUSPENDED
  TRIAL
  CANCELLED
}

enum Industry {
  ENGINEERING_CONSULTANCY
  CONSTRUCTION_CONTRACTING
  LOGISTICS
  MANUFACTURING
  FINANCE
  HEALTHCARE
  TECHNOLOGY
  RETAIL
  OTHER
}

enum PlanTier {
  STARTER
  GROWTH
  ENTERPRISE
}

/// A company/customer. The root of every tenant-scoped record.
model Tenant {
  id                   String       @id @default(cuid())
  name                 String
  slug                 String       @unique // used for path/subdomain routing, e.g. "alarrab"
  subdomain            String?      @unique
  industry             Industry     @default(OTHER)
  status               TenantStatus @default(TRIAL)
  plan                 PlanTier     @default(GROWTH)
  country              String       @default("SA")
  timezone             String       @default("Asia/Riyadh")
  locale               String       @default("en")
  // Per-company branding (applied to the workspace UI and invitation emails).
  brandColor           String? // hex, e.g. "#2953d9"
  logoUrl              String? // absolute URL to the company logo image
  // Stripe billing (null until the company subscribes to a paid plan).
  stripeCustomerId     String?      @unique
  stripeSubscriptionId String?      @unique
  subscriptionStatus   String? // e.g. active, past_due, canceled
  createdAt            DateTime     @default(now())
  updatedAt            DateTime     @updatedAt

  branches             Branch[]
  departments          Department[]
  users                User[]
  roles                Role[]
  competencyCategories CompetencyCategory[]
  competencies         Competency[]
  competencyRatings    CompetencyRating[]
  trainingPrograms     TrainingProgram[]
  trainingModules      TrainingModule[]
  lessons              Lesson[]
  lessonCompletions    LessonCompletion[]
  questions            Question[]
  questionOptions      QuestionOption[]
  quizAttempts         QuizAttempt[]
  courseCertificates   CourseCertificate[]
  enrollments          Enrollment[]
  certifications       Certification[]
  certificationAwards  CertificationAward[]
  criticalRoles        CriticalRole[]
  successionCandidates SuccessionCandidate[]
  ssoConnection        SsoConnection?
  auditLogs            AuditLog[]

  @@map("tenants")
}

/// Per-company OpenID Connect (OIDC) single sign-on configuration.
/// One connection per tenant. Enterprise plan only.
model SsoConnection {
  id             String   @id @default(cuid())
  tenantId       String   @unique
  issuer         String // e.g. https://accounts.google.com
  clientId       String
  clientSecret   String
  enabled        Boolean  @default(false)
  autoProvision  Boolean  @default(true) // create users on first SSO login
  defaultRoleKey String   @default("learner")
  allowedDomain  String? // if set, only emails on this domain may sign in
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@map("sso_connections")
}

// ---------------------------------------------------------------------------
// ORG STRUCTURE
// ---------------------------------------------------------------------------

model Branch {
  id        String   @id @default(cuid())
  tenantId  String
  name      String
  city      String?
  country   String   @default("SA")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  tenant      Tenant       @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  departments Department[]
  users       User[]

  @@index([tenantId])
  @@map("branches")
}

model Department {
  id               String   @id @default(cuid())
  tenantId         String
  branchId         String?
  name             String
  // Default training track (curriculum category) for this department. New hires
  // in the department are auto-enrolled into every published program in this
  // category. Null = no auto-assignment.
  trainingCategory String?
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  tenant Tenant  @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  branch Branch? @relation(fields: [branchId], references: [id], onDelete: SetNull)
  users  User[]

  @@index([tenantId])
  @@map("departments")
}

// ---------------------------------------------------------------------------
// IDENTITY & ACCESS
// ---------------------------------------------------------------------------

enum UserStatus {
  ACTIVE
  INVITED
  DISABLED
}

model User {
  id                 String     @id @default(cuid())
  tenantId           String
  email              String
  passwordHash       String
  firstName          String
  lastName           String
  jobTitle           String?
  status             UserStatus @default(ACTIVE)
  isTenantOwner      Boolean    @default(false)
  // Force a password change on next login (set for admin-invited employees).
  mustChangePassword Boolean    @default(false)
  // Pending email-invitation state (SHA-256 of the invite token + its expiry).
  inviteTokenHash    String?    @unique
  inviteExpiresAt    DateTime?
  // Self-service password-reset state (SHA-256 of the reset token + its expiry).
  resetTokenHash     String?    @unique
  resetExpiresAt     DateTime?
  // Email-verification state. verifiedAt is set once the address is confirmed.
  emailVerifiedAt    DateTime?
  verifyTokenHash    String?    @unique
  verifyExpiresAt    DateTime?

  branchId     String?
  departmentId String?
  managerId    String?

  // 9-box talent grid placement (1..3 each). Null until assessed.
  performanceRating Int?
  potentialRating   Int?

  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  lastLoginAt DateTime?

  tenant     Tenant      @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  branch     Branch?     @relation(fields: [branchId], references: [id], onDelete: SetNull)
  department Department? @relation(fields: [departmentId], references: [id], onDelete: SetNull)
  manager    User?       @relation("UserManager", fields: [managerId], references: [id], onDelete: SetNull)
  reports    User[]      @relation("UserManager")

  userRoles             UserRole[]
  enrollments           Enrollment[]
  lessonCompletions     LessonCompletion[]
  quizAttempts          QuizAttempt[]
  courseCertificates    CourseCertificate[]
  authoredPrograms      TrainingProgram[]     @relation("ProgramAuthor")
  competencyRatings     CompetencyRating[]
  certificationAwards   CertificationAward[]
  incumbentOf           CriticalRole[]        @relation("RoleIncumbent")
  successionCandidacies SuccessionCandidate[]
  auditLogs             AuditLog[]

  // Email is unique WITHIN a tenant, not globally — the same person may exist
  // in multiple companies.
  @@unique([tenantId, email])
  @@index([tenantId])
  @@index([managerId])
  @@map("users")
}

/// Roles are tenant-scoped. System-default roles are cloned into each tenant
/// at provisioning time (see prisma/seed.ts).
model Role {
  id          String   @id @default(cuid())
  tenantId    String
  key         String // stable identifier, e.g. "admin", "manager", "learner"
  name        String
  description String?
  isSystem    Boolean  @default(false)
  createdAt   DateTime @default(now())

  tenant          Tenant           @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  userRoles       UserRole[]
  rolePermissions RolePermission[]

  @@unique([tenantId, key])
  @@index([tenantId])
  @@map("roles")
}

/// Global permission catalog (NOT tenant-scoped). Keys are referenced in code.
model Permission {
  id          String @id @default(cuid())
  key         String @unique // e.g. "training.program.create"
  description String
  category    String @default("general")

  rolePermissions RolePermission[]

  @@map("permissions")
}

model RolePermission {
  roleId       String
  permissionId String

  role       Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@id([roleId, permissionId])
  @@map("role_permissions")
}

model UserRole {
  userId String
  roleId String

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  role Role @relation(fields: [roleId], references: [id], onDelete: Cascade)

  @@id([userId, roleId])
  @@map("user_roles")
}

// ---------------------------------------------------------------------------
// COMPETENCY FRAMEWORK  (core differentiator vs. an LMS)
// ---------------------------------------------------------------------------

model CompetencyCategory {
  id        String   @id @default(cuid())
  tenantId  String
  name      String
  createdAt DateTime @default(now())

  tenant       Tenant       @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  competencies Competency[]

  @@index([tenantId])
  @@map("competency_categories")
}

model Competency {
  id          String   @id @default(cuid())
  tenantId    String
  categoryId  String?
  name        String
  description String?
  createdAt   DateTime @default(now())

  tenant         Tenant              @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  category       CompetencyCategory? @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  programs       TrainingProgram[]
  ratings        CompetencyRating[]
  certifications Certification[]

  @@index([tenantId])
  @@map("competencies")
}

// ---------------------------------------------------------------------------
// COMPETENCY ASSESSMENTS  (measure real capability, not just completions)
// ---------------------------------------------------------------------------

/// One employee's assessed level on one competency. Levels are 1..5.
/// `current` is the working level; self/manager are the assessment inputs.
model CompetencyRating {
  id           String   @id @default(cuid())
  tenantId     String
  userId       String
  competencyId String
  selfLevel    Int      @default(1)
  managerLevel Int      @default(1)
  currentLevel Int      @default(1)
  targetLevel  Int      @default(3)
  updatedAt    DateTime @updatedAt

  tenant     Tenant     @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  user       User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  competency Competency @relation(fields: [competencyId], references: [id], onDelete: Cascade)

  @@unique([userId, competencyId])
  @@index([tenantId])
  @@map("competency_ratings")
}

// ---------------------------------------------------------------------------
// CORPORATE UNIVERSITY — INTERNAL CERTIFICATIONS
// ---------------------------------------------------------------------------

enum CertificationStatus {
  ACTIVE
  EXPIRING
  EXPIRED
}

model Certification {
  id             String              @id @default(cuid())
  tenantId       String
  name           String
  competencyId   String?
  validityMonths Int                 @default(24)
  status         CertificationStatus @default(ACTIVE)
  createdAt      DateTime            @default(now())

  tenant     Tenant               @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  competency Competency?          @relation(fields: [competencyId], references: [id], onDelete: SetNull)
  awards     CertificationAward[]

  @@index([tenantId])
  @@map("certifications")
}

model CertificationAward {
  id              String    @id @default(cuid())
  tenantId        String
  certificationId String
  userId          String
  issuedAt        DateTime  @default(now())
  expiresAt       DateTime?

  tenant        Tenant        @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  certification Certification @relation(fields: [certificationId], references: [id], onDelete: Cascade)
  user          User          @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([certificationId, userId])
  @@index([tenantId])
  @@map("certification_awards")
}

// ---------------------------------------------------------------------------
// LEADERSHIP & SUCCESSION
// ---------------------------------------------------------------------------

enum SuccessionReadiness {
  READY_NOW
  ONE_TO_TWO_YEARS
  THREE_PLUS_YEARS
}

model CriticalRole {
  id          String   @id @default(cuid())
  tenantId    String
  title       String
  incumbentId String?
  createdAt   DateTime @default(now())

  tenant     Tenant                @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  incumbent  User?                 @relation("RoleIncumbent", fields: [incumbentId], references: [id], onDelete: SetNull)
  candidates SuccessionCandidate[]

  @@index([tenantId])
  @@map("critical_roles")
}

model SuccessionCandidate {
  id             String              @id @default(cuid())
  tenantId       String
  criticalRoleId String
  userId         String
  readiness      SuccessionReadiness @default(ONE_TO_TWO_YEARS)
  score          Int                 @default(50) // readiness %, 0..100

  tenant       Tenant       @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  criticalRole CriticalRole @relation(fields: [criticalRoleId], references: [id], onDelete: Cascade)
  user         User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([criticalRoleId, userId])
  @@index([tenantId])
  @@map("succession_candidates")
}

// ---------------------------------------------------------------------------
// TRAINING / DEVELOPMENT  (the end-to-end working module for Phase 1)
// ---------------------------------------------------------------------------

enum ProgramLevel {
  FOUNDATION
  INTERMEDIATE
  ADVANCED
  LEADERSHIP
}

enum ProgramStatus {
  DRAFT
  PUBLISHED
  ARCHIVED
}

model TrainingProgram {
  id            String        @id @default(cuid())
  tenantId      String
  title         String
  titleAr       String? // Arabic title (bilingual catalog); falls back to `title`
  description   String?
  descriptionAr String? // Arabic description; falls back to `description`
  // Specialist track this program belongs to, e.g. "Accounting & Finance",
  // "Human Resources", "Project Management", "Executive / COO". Free-form so
  // tenants can define their own tracks; null = uncategorized.
  category      String?
  level         ProgramLevel  @default(FOUNDATION)
  status        ProgramStatus @default(DRAFT)
  durationHours Int           @default(0)
  competencyId  String?
  authorId      String?
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt

  tenant       Tenant              @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  competency   Competency?         @relation(fields: [competencyId], references: [id], onDelete: SetNull)
  author       User?               @relation("ProgramAuthor", fields: [authorId], references: [id], onDelete: SetNull)
  enrollments  Enrollment[]
  modules      TrainingModule[]
  certificates CourseCertificate[]

  @@index([tenantId])
  @@map("training_programs")
}

// A program is organized into ordered modules, each holding ordered lessons.
// This is the actual learning CONTENT layer (vs. the program/enrollment
// tracking layer above).
model TrainingModule {
  id         String   @id @default(cuid())
  tenantId   String
  programId  String
  title      String
  titleAr    String?
  orderIndex Int      @default(0)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  tenant  Tenant          @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  program TrainingProgram @relation(fields: [programId], references: [id], onDelete: Cascade)
  lessons Lesson[]

  @@index([tenantId])
  @@index([programId])
  @@map("training_modules")
}

enum LessonType {
  TEXT // markdown article stored in `content`
  VIDEO // `content` is a video URL (embedded)
  RESOURCE // `content` is an external link / downloadable file URL
  QUIZ // graded assessment; questions live in the `questions` relation
}

model Lesson {
  id              String     @id @default(cuid())
  tenantId        String
  moduleId        String
  title           String
  titleAr         String?
  type            LessonType @default(TEXT)
  content         String? // markdown body (TEXT) or a URL (VIDEO/RESOURCE)
  contentAr       String? // Arabic body; falls back to `content`
  // Passing score (%) for QUIZ lessons; the lesson is only "complete" once the
  // learner scores at or above this. Ignored for non-quiz lessons.
  passMark        Int        @default(70)
  durationMinutes Int        @default(0)
  orderIndex      Int        @default(0)
  createdAt       DateTime   @default(now())
  updatedAt       DateTime   @updatedAt

  tenant       Tenant             @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  module       TrainingModule     @relation(fields: [moduleId], references: [id], onDelete: Cascade)
  completions  LessonCompletion[]
  questions    Question[]
  quizAttempts QuizAttempt[]

  @@index([tenantId])
  @@index([moduleId])
  @@map("lessons")
}

enum QuestionType {
  SINGLE // one correct option (multiple choice)
  TRUE_FALSE // two options, one correct
}

// A question in a quiz lesson's question bank.
model Question {
  id            String       @id @default(cuid())
  tenantId      String
  lessonId      String
  type          QuestionType @default(SINGLE)
  prompt        String
  promptAr      String?
  explanation   String? // shown after answering (why the answer is correct)
  explanationAr String?
  orderIndex    Int          @default(0)
  createdAt     DateTime     @default(now())
  updatedAt     DateTime     @updatedAt

  tenant  Tenant           @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  lesson  Lesson           @relation(fields: [lessonId], references: [id], onDelete: Cascade)
  options QuestionOption[]

  @@index([tenantId])
  @@index([lessonId])
  @@map("questions")
}

model QuestionOption {
  id         String  @id @default(cuid())
  tenantId   String
  questionId String
  text       String
  textAr     String?
  isCorrect  Boolean @default(false)
  orderIndex Int     @default(0)

  tenant   Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  question Question @relation(fields: [questionId], references: [id], onDelete: Cascade)

  @@index([tenantId])
  @@index([questionId])
  @@map("question_options")
}

// One graded attempt at a quiz lesson. `answers` is a JSON map of
// questionId -> chosen optionId. The best passing attempt drives completion.
model QuizAttempt {
  id        String   @id @default(cuid())
  tenantId  String
  lessonId  String
  userId    String
  score     Int // 0..100
  passed    Boolean  @default(false)
  answers   String // JSON: { [questionId]: optionId }
  createdAt DateTime @default(now())

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  lesson Lesson @relation(fields: [lessonId], references: [id], onDelete: Cascade)
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([tenantId])
  @@index([lessonId])
  @@index([userId])
  @@map("quiz_attempts")
}

// One row per (user, lesson) once the learner marks the lesson complete.
// Enrollment.progress is recomputed from these (completed / total lessons).
model LessonCompletion {
  id          String   @id @default(cuid())
  tenantId    String
  lessonId    String
  userId      String
  completedAt DateTime @default(now())

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  lesson Lesson @relation(fields: [lessonId], references: [id], onDelete: Cascade)
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([lessonId, userId])
  @@index([tenantId])
  @@index([userId])
  @@map("lesson_completions")
}

// Auto-issued when a learner completes a course (all lessons done / quizzes
// passed). One per (program, user). `serial` is a human-readable verification
// code shown on the printable certificate.
model CourseCertificate {
  id        String   @id @default(cuid())
  tenantId  String
  userId    String
  programId String
  serial    String   @unique
  score     Int? // final/average quiz score at issuance, if the course had quizzes
  issuedAt  DateTime @default(now())

  tenant  Tenant          @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  user    User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  program TrainingProgram @relation(fields: [programId], references: [id], onDelete: Cascade)

  @@unique([programId, userId])
  @@index([tenantId])
  @@index([userId])
  @@map("course_certificates")
}

enum EnrollmentStatus {
  ENROLLED
  IN_PROGRESS
  COMPLETED
  DROPPED
}

model Enrollment {
  id          String           @id @default(cuid())
  tenantId    String
  programId   String
  userId      String
  status      EnrollmentStatus @default(ENROLLED)
  progress    Int              @default(0) // 0-100
  score       Int? // final assessment score, 0-100
  enrolledAt  DateTime         @default(now())
  completedAt DateTime?

  tenant  Tenant          @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  program TrainingProgram @relation(fields: [programId], references: [id], onDelete: Cascade)
  user    User            @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([programId, userId])
  @@index([tenantId])
  @@index([userId])
  @@map("enrollments")
}

// ---------------------------------------------------------------------------
// AUDIT
// ---------------------------------------------------------------------------

model AuditLog {
  id        String   @id @default(cuid())
  tenantId  String
  actorId   String?
  action    String // e.g. "user.login", "training.program.create"
  entity    String? // e.g. "TrainingProgram"
  entityId  String?
  metadata  Json?
  createdAt DateTime @default(now())

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  actor  User?  @relation(fields: [actorId], references: [id], onDelete: SetNull)

  @@index([tenantId])
  @@index([tenantId, createdAt])
  @@map("audit_logs")
}
