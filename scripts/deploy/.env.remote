# Generated by the deployment process (see deployment.md) and copied to
# /opt/bcap386074/.env on the remote host on first deploy. Values below are
# placeholders — the real file on the server has generated secrets.
#
# IMPORTANT: no quotes around values. This file is read two ways: sourced as
# POSIX shell (`. .env`) by remote-deploy.sh, AND passed straight to
# `docker run --env-file` — Docker does NOT strip quote characters, so a
# quoted value here becomes part of the actual env var value inside the
# container (e.g. AUTH_SECRET ends up literally wrapped in " chars).
POSTGRES_SUPERUSER_PASSWORD=REPLACE_ME
BCAP_APP_DB_PASSWORD=REPLACE_ME
DATABASE_URL=postgresql://bcap_app:REPLACE_ME@bcap386074-db:5432/bcap?schema=public
AUTH_SECRET=REPLACE_ME
APP_BASE_URL=http://13.140.138.252:3860
ROOT_DOMAIN=13.140.138.252:3860
NODE_ENV=production
